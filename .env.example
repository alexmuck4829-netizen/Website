# ─────────────────────────────────────────────────────────────
# ONE MORE CLICK STUDIO — environment
# Copy to .env.local and fill in. Never commit .env.local.
# Everything below is OPTIONAL: with no .env file at all the app
# runs in demo mode (local storage, demo checkout, dev admin password).
# ─────────────────────────────────────────────────────────────

# --- Site ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://onemoreclick.studio

# --- Discord ------------------------------------------------
# Your real invite link. Used by the navbar, footer and every Discord CTA.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite

# --- Admin dashboard ----------------------------------------
# REQUIRED BEFORE DEPLOYING. Without it the dev default "omc-admin" is used.
ADMIN_PASSWORD=

# Signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Signs temporary download URLs. Generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# --- Stripe (checkout) --------------------------------------
# Leave blank for demo checkout. Setting STRIPE_SECRET_KEY switches the app to
# real Stripe Checkout — see src/lib/services/payment-service.ts for the
# remaining step (npm i stripe, then uncomment createStripeCheckout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Storage ------------------------------------------------
# "local" (default) writes to ./.storage — fine for development.
# "supabase" requires implementing SupabaseStorageProvider in
# src/lib/services/storage-service.ts.
STORAGE_PROVIDER=local

# --- Supabase (database + auth + storage) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
